# Local, throw-away test environment only. These are NOT real credentials.
TZ=Etc/UTC
KOMODO_DATABASE_USERNAME=admin
KOMODO_DATABASE_PASSWORD=admin
KOMODO_HOST=http://localhost:19120
KOMODO_TITLE=Komodo E2E
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=e2e-admin
KOMODO_INIT_ADMIN_PASSWORD=e2e-local-password
KOMODO_FIRST_SERVER_NAME=Local
KOMODO_DISABLE_INIT_RESOURCES=true
KOMODO_WEBHOOK_SECRET=e2e_webhook_secret
KOMODO_JWT_SECRET=e2e_jwt_secret
KOMODO_MONITORING_INTERVAL=5-sec
KOMODO_RESOURCE_POLL_INTERVAL=1-hr
KOMODO_DISABLE_USER_REGISTRATION=true

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=Local
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false
